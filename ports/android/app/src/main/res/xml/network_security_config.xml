<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- MASVS-NETWORK: no cleartext, no user-installed CAs (state MITM). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
